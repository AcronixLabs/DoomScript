%YAML 1.2
---
name: Doom-Script
file_extensions:
  - ds
scope: source.doomscript

contexts:
  main:
    - include: comments
    - include: strings
    - include: keywords
    - include: types
    - include: functions
    - include: numbers
    - include: operators

  comments:
    - match: //
      scope: punctuation.definition.comment.doomscript
      push:
        - meta_scope: comment.line.double-slash.doomscript
        - match: $\n?
          pop: true
    - match: /\*
      scope: punctuation.definition.comment.begin.doomscript
      push:
        - meta_scope: comment.block.doomscript
        - match: \*/
          scope: punctuation.definition.comment.end.doomscript
          pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.doomscript
      push:
        - meta_scope: string.quoted.double.doomscript
        - match: \\.
          scope: constant.character.escape.doomscript
        - match: '"'
          scope: punctuation.definition.string.end.doomscript
          pop: true

  keywords:
    - match: \b(map|import|from|export|loadout|frag|eject|wave|patrol|hunt|berserk|respawn|sector|chamber)\b
      scope: keyword.control.doomscript

  types:
    - match: \b(slayer|imp|cyberdemon|cacodemon|archvile|hellfire|bfg9000|soulsphere|chainsaw|fist|bruiser|revenant|plasma|gib|none|uac)\b
      scope: storage.type.doomscript

  functions:
    - match: \b([a-zA-Z_][a-zA-Z0-9_]*)\s*\(
      captures:
        1: entity.name.function.doomscript

  numbers:
    - match: \b0[xX][0-9a-fA-F]+\b
      scope: constant.numeric.hex.doomscript
    - match: \b\d+\.\d+\b
      scope: constant.numeric.float.doomscript
    - match: \b\d+\b
      scope: constant.numeric.integer.doomscript

  operators:
    - match: '==|!=|<=|>=|&&|\|\||\+=|-=|\*=|/=|%=|->|\*\*'
      scope: keyword.operator.doomscript
    - match: '[+\-*/%=<>!&|^~]'
      scope: keyword.operator.doomscript
